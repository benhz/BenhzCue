{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "DIFY_API_KEY": "@dify-api-key",
    "DIFY_WORKFLOW_ID": "@dify-workflow-id",
    "DELETE_AFTER_PARSE": "true"
  }
}
